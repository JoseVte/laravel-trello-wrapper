{
    "name": "josrom/laravel-trello-wrapper",
    "description": "Trello API wrapper for Laravel 13",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.0.1",
        "guzzlehttp/psr7": "^2.1.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "josrom/php-trello-api": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "josrom/phpunit-unicode-printer": "^9.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "LaravelTrello\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelTrello\\TrelloServiceProvider"
            ],
            "aliases": {
                "LaravelTrello": "LaravelTrello\\Facade"
            }
        }
    },
    "authors": [
        {
            "name": "Jose Vicente Orts Romero",
            "email": "jvortsromero@gmail.com"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
